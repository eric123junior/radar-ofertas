# Copie para .env e preencha. Loja sem credencial fica desligada.

# O que monitorar (separado por virgula)
PALAVRAS=fone bluetooth,smartwatch,air fryer,ssd,monitor,iphone
# Criterio de oportunidade
DESCONTO_MINIMO=40
NOTA_MINIMA=60
# PRECO_MAXIMO=3000
MAX_POR_EXECUCAO=10
HORAS_SEM_REPETIR=24

# Amazon Associados - PA-API 5 (associados.amazon.com.br > Ferramentas > Product Advertising API)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_TAG=seutag-20

# Mercado Livre - app em developers.mercadolivre.com.br
ML_ACCESS_TOKEN=
# Use UM dos dois formatos de link de afiliado:
# ML_LINK_AFILIADO=https://seu-encurtador.com/?u={url}
ML_MATT_TOOL=
ML_MATT_WORD=

# Shopee Afiliados - affiliate.shopee.com.br > Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Lomadee (Magalu, Americanas, Casas Bahia...) - developer.lomadee.com
LOMADEE_APP_TOKEN=
LOMADEE_SOURCE_ID=

# Awin - URLs de feed de produtos (Toolbox > Create-a-Feed), separadas por virgula
AWIN_FEEDS=

# Telegram - token do @BotFather e @canal (bot precisa ser admin)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=@seucanal
